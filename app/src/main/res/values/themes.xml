<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Toolbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ 启动页（低版本由 core-splashscreen 兼容） -->
    <style name="Theme.Toolbox.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Toolbox</item>
    </style>
</resources>
